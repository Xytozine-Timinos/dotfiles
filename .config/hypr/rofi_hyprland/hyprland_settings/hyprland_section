#!/bin/bash

source ~/.config/dtf-config/config
rofi_theme=${rofi_theme:-black}

if [[ $rofi_theme == "white" ]]; then
	path_to_theme="~/.config/rofi/rofi_theme/white/white.rasi"
else
	path_to_theme="~/.config/rofi/rofi_theme/black/black.rasi"
fi

hypr_submenu_height=625px
hypr_submenu_width=390px

hypr_submenu() {

	hypr_sub="  Main Config"
	exec="  Launch On Startup"
	coloring="  General & Decoration"
	gaps_border="󰃐  Misc, Render & Layout"
	animations="󰆨  Animations"
	input_opt="󰄠  Input & Gestures"
	plugins_opt="  Plugins & Plugins Load"
	for_window_rules="!  Window Rules"
	system_keybinds="  System Keybinds 󰌏 "
	app_keybinds="󰀻  App Launch Keybinds 󰌏 "
	special_key_keybinds="󰘲  Special Key Keybinds 󰌏 "
	plugins_keybinds="  Plugins Keybinds 󰌏 "
	environment_vars="󰆧  Environment Variables"

	select4=$(echo -e "$hypr_sub\n$exec\n$environment_vars\n$plugins_opt\n$coloring\n$animations\n$gaps_border\n$for_window_rules\n$input_opt\n$system_keybinds\n$app_keybinds\n$special_key_keybinds\n$plugins_keybinds\n$goback" | rofi -x11 -dmenu -i -theme-str "window {height: $hypr_submenu_height; width: $hypr_submenu_width;}" -theme-str "listview {columns: 1; layout: vertical;}" -p " Hyprland   " -theme $path_to_theme)

	case $select4 in
	$hypr_sub)
		$TERMINAL -e nvim ~/.config/hypr/hyprland.lua
		;;
	$exec)
		$TERMINAL -e nvim ~/.config/hypr/hyprland_config_modules/exec.lua
		;;
	$coloring)
		$TERMINAL -e nvim ~/.config/hypr/hyprland_config_modules/decorations.lua
		;;
	$animations)
		$TERMINAL -e nvim ~/.config/hypr/hyprland_config_modules/animations.lua
		;;
	$input_opt)
		$TERMINAL -e nvim ~/.config/hypr/hyprland_config_modules/input.lua
		;;
	$for_window_rules)
		$TERMINAL -e nvim ~/.config/hypr/hyprland_config_modules/window_rules.lua
		;;
	$system_keybinds)
		$TERMINAL -e nvim ~/.config/hypr/hyprland_config_modules/keybinds/wm_keybinds.lua
		;;
	$special_key_keybinds)
		$TERMINAL -e nvim ~/.config/hypr/hyprland_config_modules/keybinds/special_keybinds.lua
		;;
	$app_keybinds)
		$TERMINAL -e nvim ~/.config/hypr/hyprland_config_modules/keybinds/app_keybinds.lua
		;;
	$plugins_keybinds)
		$TERMINAL -e nvim ~/.config/hypr/hyprland_config_modules/keybinds/plugin_keybinds.lua
		;;
	$gaps_border)
		$TERMINAL -e nvim ~/.config/hypr/hyprland_config_modules/misc.lua
		;;
	$plugins_opt)
		$TERMINAL -e nvim ~/.config/hypr/hyprland_config_modules/plugins.lua
		;;
	$environment_vars)
		$TERMINAL -e nvim ~/.config/hypr/hyprland_config_modules/env.lua
		;;
	$goback)
		main_menu
		;;
	esac
}
