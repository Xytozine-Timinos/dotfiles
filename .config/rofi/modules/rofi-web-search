#!/usr/bin/env bash

#THIS SCRIPT WAS FABRICATED BY ME (Xgameisdabest, aka xytozine)

source ~/.config/dtf-config/config
rofi_theme=${rofi_theme:-black}

if [[ $rofi_theme == "white" ]]; then
	path_to_theme="~/.config/rofi/rofi_theme/white/white.rasi"
	path_to_theme_search="~/.config/rofi/rofi_theme/white/white-search.rasi"
else
	path_to_theme="~/.config/rofi/rofi_theme/black/black.rasi"
	path_to_theme_search="~/.config/rofi/rofi_theme/black/black-search.rasi"
fi

web="  Web Search  "
web_search_brave="  Web Search (Brave)  "
web_search_google="  Web Search (Google)  "
yt="  Youtube  "
github="  Github  "
codeberg="  Codeberg  "
ai="  Ai  "
virustotal="󰨯  Virus Total 󰌧 "
flathub="  Flathub 󰌧 "
nerdfonts="󰛖  Nerd Fonts 󰌧 "
this_dotfiles="  This Dotfiles Repo 󰌧 "
back="Back 󰌍"
quit="Exit 󰈆 "

web() {

	options=$(echo -e "$web_search_brave\n$web_search_google\n$back" | rofi -x11 -dmenu -theme $path_to_theme -theme-str "window {height: 210px; width: 350px;}" -p " Search Engines   ")

	web_search_google_func(){
	search=$(echo | rofi -x11 -dmenu -theme $path_to_theme_search -theme-str "window {height: 90px;}" -p " Google   ")
	search_engine="https://www.google.com/search?q="
	main() {
		if [[ -n "$search" ]]; then
			url="$search_engine$search"
			xdg-open "$url" &
			exit 0
		else
			exit 0
		fi
	}
	main
	exit 0
	}

	web_search_brave_func(){
	search=$(echo | rofi -x11 -dmenu -theme $path_to_theme_search -theme-str "window {height: 90px;}" -p " Brave   ")
	search_engine="https://search.brave.com/search?q="
	main() {
		if [[ -n "$search" ]]; then
			url="$search_engine$search"
			xdg-open "$url" &
			exit 0
		else
			exit 0
		fi
	}
	main
	exit 0
	}

	case $options in
		$web_search_brave)
			web_search_brave_func
			;;
		$web_search_google)
			web_search_google_func
			;;
		$back)
			main
			;;

	esac
}

yt() {
	open_the_webpage_yt="󰖟  Open the website 󰌧 "
	open_the_search_bar_yt="  Search for videos  "

	choice=$(echo -e "$open_the_webpage_yt\n$open_the_search_bar_yt\n$back" | rofi -x11 -dmenu -theme $path_to_theme -theme-str "window {height: 210px; width: 350px;}" -p " Videos   ")

	search_yt() {
		search=$(echo | rofi -x11 -dmenu -theme $path_to_theme_search -theme-str "window {height: 90px;}" -p " Videos   ")
		search_engine="https://www.youtube.com/results?search_query="
		main() {
			if [[ -n "$search" ]]; then
				url="$search_engine$search"
				xdg-open "$url" &
				exit 0
			else
				exit 0
			fi
		}
		main
		exit 0
	}

	case $choice in
	$open_the_webpage_yt)
		xdg-open https://youtube.com &
		exit 0
		;;
	$open_the_search_bar_yt)
		search_yt
		;;
	$back)
		main
		;;
	esac
}

github() {
	open_the_webpage_git="󰖟  Open the website 󰌧 "
	open_the_search_bar_git="  Search for repositories  "

	choice=$(echo -e "$open_the_webpage_git\n$open_the_search_bar_git\n$back" | rofi -x11 -dmenu -theme $path_to_theme -theme-str "window {height: 210px; width: 400px;}" -p " Github   ")

	search_github() {
		search=$(echo | rofi -x11 -dmenu -theme $path_to_theme_search -theme-str "window {height: 90px;}" -p " Repositories   ")
		search_engine="https://github.com/search?q="
		main() {
			if [[ -n "$search" ]]; then
				query=$(echo "$search" | sed 's/ /+/g')
				url="${search_engine}${query}&type=repositories"
				xdg-open "$url" &
				exit 0
			else
				exit 0
			fi
		}
		main
		exit 0
	}

	case $choice in
	$open_the_webpage_git)
		xdg-open https://github.com &
		exit 0
		;;
	$open_the_search_bar_git)
		search_github
		;;
	$back)
		main
		;;
	esac

}

codeberg() {
	local open_the_webpage_git="󰖟  Open the website 󰌧 "
	local open_the_search_bar_git="  Search for repositories  "

	# Combined the menu choices into Rofi
	local choice
	choice=$(echo -e "$open_the_webpage_git\n$open_the_search_bar_git\n$back" | rofi -x11 -dmenu -theme "$path_to_theme" -theme-str "window {height: 210px; width: 400px;}" -p " Codeberg   ")

	search_codeberg() {
		local search
		search=$(echo | rofi -x11 -dmenu -theme "$path_to_theme_search" -theme-str "window {height: 90px;}" -p " Repositories   ")

		# Codeberg/Forgejo use /explore/repos for global repository searching
		local search_engine="https://codeberg.org/explore/repos?q="

		if [[ -n "$search" ]]; then
			# URL encoding the search query safely
			local query
			query=$(echo "$search" | sed 's/ /+/g')
			xdg-open "${search_engine}${query}" &
			exit 0
		else
			exit 0
		fi
	}

	case "$choice" in
	"$open_the_webpage_git")
		xdg-open "https://codeberg.org" &
		exit 0
		;;
	"$open_the_search_bar_git")
		search_codeberg
		;;
	"$back")
		main
		;;
	esac
}

ai() {
	gemini="  Gemini 󰌧 "
	chatgpt="  ChatGpt 󰌧 "
	claude="  Claude 󰌧 "
	model_choice=$(echo -e "$gemini\n$chatgpt\n$claude\n$back" | rofi -x11 -dmenu -theme $path_to_theme -theme-str "window {height: 245px; width: 280px;}" -theme-str "listview {columns: 1; layout: vertical;}" -p " Ai  ")

	case $model_choice in
	$gemini)
		xdg-open https://gemini.google.com &
		exit 0
		;;
	$chatgpt)
		xdg-open https://chatgpt.com &
		exit 0
		;;
	$claude)
		xdg-open https://claude.ai &
		exit 0
		;;
	$back)
		main
		;;
	esac
}

main() {
	select=$(echo -e "$web\n$yt\n$ai\n$codeberg\n$github\n$flathub\n$virustotal\n$nerdfonts\n$this_dotfiles\n$quit" | rofi -x11 -dmenu -theme $path_to_theme -theme-str "window {height: 475px; width: 350px;}" -theme-str "listview {columns: 1; layout: vertical;}" -p " Web Shortcuts & Search  ")

	case $select in
	$web)
		web
		;;
	$yt)
		yt
		;;
	$github)
		github
		;;
	$this_dotfiles)
		xdg-open https://codeberg.org/Xytozine/dotfiles &
		exit 0
		;;
	$nerdfonts)
		xdg-open https://www.nerdfonts.com/cheat-sheet &
		exit 0
		;;
	$virustotal)
		xdg-open https://www.virustotal.com &
		exit 0
		;;
	$ai)
		ai
		;;
	$flathub)
		xdg-open https://flathub.org &
		exit 0
		;;
	$codeberg)
		codeberg
		;;
	esac
}

main
